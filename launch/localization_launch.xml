<launch>
  <!-- FAST-LIO odometry + global localization in a pre-built map.
       TF: camera_init -> map_frame (transform_fusion, the inverse of map -> camera_init)
           camera_init -> <lidar frame> (FAST-LIO)
       map_frame hangs below camera_init, so camera_init keeps any parent it already has
       (odom -> lio_map -> camera_init in the legged stack) and the FAR planner keeps its "map" (= camera_init).
       config_file holds the FAST-LIO params under /** plus the global_localization and
       transform_fusion sections; pick the one of your LiDAR (unitree_l2, avia, horizon, mid360, ouster64, velodyne). -->
  <arg name="use_sim_time" default="true" description="Use simulation (Gazebo) clock if true"/>
  <arg name="fast_lio" default="false" description="Run FAST-LIO here; false reuses the one of fast_lio_slam_launch.xml (/Odometry, /cloud_registered), which must be running"/>
  <arg name="config_path" default="$(find-pkg-share fast_lio_localization)/config" description="Yaml config file path"/>
  <arg name="config_file" default="unitree_l2.yaml" description="Config file"/>
  <arg name="map" default="$(env HOME)/RaNAV/src/FAST_LIO_SLAM_ROS2/save_data/optimized_map.pcd" description="Global map point cloud (.pcd)"/>
  <arg name="map_frame" default="global_map" description="Frame of the global map, child of camera_init"/>
  <arg name="python" default="$(env HOME)/RaNAV/.venv-yolo/bin/python" description="Interpreter for the localization scripts, it needs open3d (e.g. the python of a venv created with --system-site-packages)"/>
  <arg name="rviz" default="true" description="Use RViz to monitor results"/>
  <arg name="rviz_cfg" default="$(find-pkg-share fast_lio_localization)/rviz_cfg/localization.rviz" description="RViz config file path (fixed frame global_map)"/>

  <node if="$(var fast_lio)" pkg="fast_lio_localization" exec="fastlio_mapping" name="laser_mapping" output="screen">
    <param from="$(var config_path)/$(var config_file)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- localization -->
  <node pkg="fast_lio_localization" exec="global_localization.py" name="global_localization" output="screen"
        launch-prefix="$(var python)">
    <param from="$(var config_path)/$(var config_file)"/>
    <param name="map_frame" value="$(var map_frame)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- transform fusion -->
  <node pkg="fast_lio_localization" exec="transform_fusion.py" name="transform_fusion" output="screen"
        launch-prefix="$(var python)">
    <param from="$(var config_path)/$(var config_file)"/>
    <param name="map_frame" value="$(var map_frame)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- global map -->
  <node pkg="pcl_ros" exec="pcd_to_pointcloud" name="map_publisher" output="screen">
    <param name="file_name" value="$(var map)"/>
    <param name="tf_frame" value="$(var map_frame)"/>
    <param name="publishing_period_ms" value="5000"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="cloud_pcd" to="/map"/>
  </node>

  <node if="$(var rviz)" pkg="rviz2" exec="rviz2" name="rviz2" args="-d $(var rviz_cfg)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
