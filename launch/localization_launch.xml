<launch>
  <!-- Global localization in a pre-built map, on top of a running FAST-LIO: it reads /Odometry and /cloud_registered
       (dense, in FAST-LIO's world frame odom_frame) and does not start FAST-LIO itself.
       TF: odom_frame -> map_frame (transform_fusion, the inverse of map -> odom): map_frame hangs below FAST-LIO's
       frame, so that one keeps any parent it already has.
       Initial pose: /initialpose (RViz 2D Pose Estimate, or publish_initial_pose.py); with init_from_odom,
       global_localization guesses it from a second odometry (legged_odom_topic) instead, see the script. -->
  <arg name="map" description="Global map point cloud (.pcd)"/>
  <arg name="map_frame" default="global_map" description="Frame of the global map, child of odom_frame"/>
  <arg name="odom_frame" default="camera_init" description="FAST-LIO world frame, of /Odometry and /cloud_registered"/>
  <arg name="fov" default="1.6" description="LiDAR horizontal FOV [rad]; more than 3.14 is a spinning LiDAR, the map is then cropped by distance only"/>
  <arg name="fov_far" default="150.0" description="Map crop distance [m]"/>
  <arg name="init_from_odom" default="false" description="Guess the initial pose from legged_odom_topic instead of waiting for /initialpose"/>
  <arg name="python" default="python3" description="Interpreter for the localization scripts, it needs open3d (e.g. the python of a venv created with --system-site-packages)"/>
  <arg name="use_sim_time" default="false"/>
  <arg name="rviz" default="true"/>
  <arg name="rviz_cfg" default="$(find-pkg-share fast_lio_localization)/rviz_cfg/localization.rviz" description="RViz config file (fixed frame global_map)"/>

  <node pkg="fast_lio_localization" exec="global_localization.py" name="global_localization" output="screen"
        launch-prefix="$(var python)">
    <param name="map_frame" value="$(var map_frame)"/>
    <param name="odom_frame" value="$(var odom_frame)"/>
    <param name="fov" value="$(var fov)"/>
    <param name="fov_far" value="$(var fov_far)"/>
    <param name="init_from_odom" value="$(var init_from_odom)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <node pkg="fast_lio_localization" exec="transform_fusion.py" name="transform_fusion" output="screen"
        launch-prefix="$(var python)">
    <param name="map_frame" value="$(var map_frame)"/>
    <param name="odom_frame" value="$(var odom_frame)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>

  <!-- the global map, on /map every 5 s -->
  <node pkg="pcl_ros" exec="pcd_to_pointcloud" name="map_publisher" output="screen">
    <param name="file_name" value="$(var map)"/>
    <param name="tf_frame" value="$(var map_frame)"/>
    <param name="publishing_period_ms" value="5000"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="cloud_pcd" to="/map"/>
  </node>

  <node if="$(var rviz)" pkg="rviz2" exec="rviz2" name="rviz2" args="-d $(var rviz_cfg)">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
